generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  NGO_ADMIN
  SURVEYOR
  VOLUNTEER
  USER
}

enum NgoVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ReporterRole {
  SUPER_ADMIN
  NGO_ADMIN
  SURVEYOR
  USER
}

enum SourceChannel {
  USER_APP
  SURVEYOR_APP
  NGO_PORTAL
  ADMIN_PANEL
}

enum SourceType {
  MASTER_REPORT
  SURVEYOR_DIRECT
  NGO_INTERNAL
  ADMIN_CREATED
}

enum PriorityLabel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MasterReportStatus {
  SUBMITTED
  UNDER_REVIEW
  CLASSIFIED
  DUPLICATE_FLAGGED
  ROUTED_TO_NGO
  ACCEPTED_BY_NGO
  REJECTED_BY_NGO
  REASSIGNMENT_PENDING
  VOLUNTEER_ASSIGNED
  IN_PROGRESS
  COMPLETED_PENDING_VERIFICATION
  VERIFIED_CLOSED
  INVALID
  ESCALATED
  DUPLICATE_MERGED
}

enum NgoTaskStatus {
  PENDING_NGO_ACCEPTANCE
  ACCEPTED
  REJECTED
  VOLUNTEER_ASSIGNMENT_PENDING
  ASSIGNED
  VOLUNTEER_REJECTED
  REASSIGNMENT_NEEDED
  IN_PROGRESS
  COMPLETED_PENDING_VERIFICATION
  VERIFIED_CLOSED
  REWORK_NEEDED
  ESCALATED
}

enum NgoDecision {
  PENDING
  ACCEPTED
  REJECTED
  REROUTED
  ESCALATED
}

enum EvidenceVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  OFFLINE
  UNAVAILABLE
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED_PENDING_VERIFICATION
  VERIFIED_CLOSED
  UNAVAILABLE
  REASSIGNED
}

enum NotificationType {
  REPORT_CREATED
  REPORT_ROUTED
  NGO_DECISION
  VOLUNTEER_ASSIGNED
  VOLUNTEER_RESPONSE
  TASK_STATUS
  TASK_EVIDENCE
  TASK_VERIFIED
  REWORK_REQUESTED
  ESCALATION
  GENERAL
}

enum AiDecisionType {
  DOMAIN_CLASSIFICATION
  PRIORITY_SCORING
  NGO_MATCH
  VOLUNTEER_MATCH
  DUPLICATE_CHECK
}

enum EscalationStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Category {
  id                  String         @id @default(cuid())
  name                String
  slug                String         @unique
  description         String?
  colorHex            String?
  iconKey             String?
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  ngoDomains          NgoDomain[]
  selectedInReports   MasterReport[] @relation("SelectedCategory")
  predictedInReports  MasterReport[] @relation("PredictedCategory")
  tasks               NgoTask[]

  @@map("categories")
}

model User {
  id                          String                @id @default(cuid())
  fullName                    String
  email                       String                @unique
  phone                       String?               @unique
  passwordHash                String
  role                        Role
  currentAddress              String?
  profileImageUrl             String?
  isActive                    Boolean               @default(true)
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  createdNgos                 Ngo[]                 @relation("NgoCreator")
  surveyProfile               SurveyorProfile?
  volunteerProfile            VolunteerProfile?
  reports                     MasterReport[]        @relation("ReportReporter")
  reportedTasks               NgoTask[]             @relation("TaskReporter")
  assignedTasks               NgoTask[]             @relation("TaskAssigner")
  notifications               Notification[]
  auditLogs                   AuditLog[]            @relation("AuditActor")
  refreshTokens               RefreshToken[]
  passwordResetTokens         PasswordResetToken[]
  escalationsRaised           Escalation[]          @relation("EscalationRaiser")
  escalationsResolved         Escalation[]          @relation("EscalationResolver")
  reportStatusChanges         ReportStatusHistory[] @relation("ReportStatusActor")
  taskStatusChanges           TaskStatusHistory[]   @relation("TaskStatusActor")
  taskEvidenceReviewed        TaskEvidence[]        @relation("EvidenceReviewer")
  volunteerAssignmentsCreated VolunteerAssignment[] @relation("AssignmentActor")

  @@index([role, isActive])
  @@map("users")
}

model Ngo {
  id                      String                @id @default(cuid())
  name                    String
  officialEmail           String                @unique
  phone                   String
  description             String?
  headquartersAddress     String
  latitude                Float
  longitude               Float
  serviceRadiusKm         Float
  verificationStatus      NgoVerificationStatus @default(PENDING)
  verificationDocumentUrl String?
  createdByUserId         String
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  createdBy               User                  @relation("NgoCreator", fields: [createdByUserId], references: [id])
  domains                 NgoDomain[]
  regions                 NgoRegion[]
  surveyors               SurveyorProfile[]
  volunteers              VolunteerProfile[]
  routedReports           MasterReport[]        @relation("ReportRoutedNgo")
  sourceReports           MasterReport[]        @relation("ReportSourceNgo")
  tasks                   NgoTask[]

  @@index([verificationStatus])
  @@map("ngos")
}

model NgoDomain {
  id         String   @id @default(cuid())
  ngoId      String
  categoryId String
  createdAt  DateTime @default(now())
  ngo        Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([ngoId, categoryId])
  @@map("ngo_domains")
}

model NgoRegion {
  id               String   @id @default(cuid())
  ngoId            String
  regionName       String
  latitude         Float
  longitude        Float
  coverageRadiusKm Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  ngo              Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)

  @@index([ngoId])
  @@map("ngo_regions")
}

model SurveyorProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  ngoId              String
  assignedRegionName String
  latitude           Float
  longitude          Float
  serviceRadiusKm    Float
  activeStatus       Boolean        @default(true)
  idProofUrl         String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ngo                Ngo            @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  sourceReports      MasterReport[] @relation("ReportSourceSurveyor")

  @@index([ngoId, activeStatus])
  @@map("surveyors")
}

model VolunteerProfile {
  id                String             @id @default(cuid())
  userId            String             @unique
  ngoId             String
  latitude          Float
  longitude         Float
  serviceRadiusKm   Float
  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  availableFrom     DateTime?
  availableTo       DateTime?
  skillsJson        Json
  currentWorkload   Int                @default(0)
  vehicleType       String?
  rating            Float              @default(4.5)
  tasksCompleted    Int                @default(0)
  acceptanceRate    Float              @default(100)
  idProofUrl        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ngo               Ngo                @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  assignedTasks     NgoTask[]          @relation("AssignedVolunteer")
  assignments       VolunteerAssignment[]
  evidence          TaskEvidence[]

  @@index([ngoId, availabilityStatus])
  @@map("volunteers")
}

model DuplicateGroup {
  id                String         @id @default(cuid())
  canonicalReportId String?        @unique
  createdAt         DateTime       @default(now())
  canonicalReport   MasterReport?  @relation("CanonicalReport", fields: [canonicalReportId], references: [id])
  reports           MasterReport[] @relation("DuplicateMembers")

  @@map("duplicate_groups")
}

model MasterReport {
  id                        String              @id @default(cuid())
  title                     String
  description               String
  reporterUserId            String
  reporterRole              ReporterRole
  sourceChannel             SourceChannel
  sourceNgoId               String?
  sourceSurveyorId          String?
  originalCategoryId        String?
  aiPredictedCategoryId     String?
  aiConfidence              Float?
  aiReasoning               String?
  priorityScore             Int                 @default(0)
  priorityLabel             PriorityLabel       @default(MEDIUM)
  latitude                  Float
  longitude                 Float
  address                   String
  mediaUrl                  String?
  mediaType                 String?
  duplicateGroupId          String?
  status                    MasterReportStatus  @default(SUBMITTED)
  routedNgoId               String?
  linkedNgoTaskId           String?             @unique
  escalationFlag            Boolean             @default(false)
  regionalExceptionFlag     Boolean             @default(false)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  reporter                  User                @relation("ReportReporter", fields: [reporterUserId], references: [id])
  sourceNgo                 Ngo?                @relation("ReportSourceNgo", fields: [sourceNgoId], references: [id])
  sourceSurveyor            SurveyorProfile?    @relation("ReportSourceSurveyor", fields: [sourceSurveyorId], references: [id])
  originalCategory          Category?           @relation("SelectedCategory", fields: [originalCategoryId], references: [id])
  aiPredictedCategory       Category?           @relation("PredictedCategory", fields: [aiPredictedCategoryId], references: [id])
  duplicateGroup            DuplicateGroup?     @relation("DuplicateMembers", fields: [duplicateGroupId], references: [id])
  routedNgo                 Ngo?                @relation("ReportRoutedNgo", fields: [routedNgoId], references: [id])
  linkedNgoTask             NgoTask?            @relation("ReportTaskLink", fields: [linkedNgoTaskId], references: [id])
  canonicalInDuplicateGroup DuplicateGroup?     @relation("CanonicalReport")
  statusHistory             ReportStatusHistory[]
  aiDecisions               AiDecision[]
  escalations               Escalation[]

  @@index([status, priorityLabel])
  @@index([latitude, longitude])
  @@index([routedNgoId, createdAt])
  @@map("master_reports")
}

model NgoTask {
  id                  String            @id @default(cuid())
  ngoId               String
  sourceType          SourceType
  reportedByUserId    String?
  title               String
  description         String
  categoryId          String?
  priorityLabel       PriorityLabel
  priorityScore       Int               @default(0)
  latitude            Float
  longitude           Float
  address             String
  status              NgoTaskStatus     @default(PENDING_NGO_ACCEPTANCE)
  assignedVolunteerId String?
  assignedByUserId    String?
  ngoDecision         NgoDecision       @default(PENDING)
  acceptedAt          DateTime?
  dueDate             DateTime?
  rejectionReason     String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  ngo                 Ngo               @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  reportedByUser      User?             @relation("TaskReporter", fields: [reportedByUserId], references: [id])
  category            Category?         @relation(fields: [categoryId], references: [id])
  assignedVolunteer   VolunteerProfile? @relation("AssignedVolunteer", fields: [assignedVolunteerId], references: [id])
  assignedByUser      User?             @relation("TaskAssigner", fields: [assignedByUserId], references: [id])
  masterReport        MasterReport?     @relation("ReportTaskLink")
  statusHistory       TaskStatusHistory[]
  evidence            TaskEvidence[]
  assignments         VolunteerAssignment[]
  aiDecisions         AiDecision[]
  escalations         Escalation[]

  @@index([ngoId, status])
  @@index([assignedVolunteerId])
  @@index([priorityLabel, createdAt])
  @@map("ngo_tasks")
}

model ReportStatusHistory {
  id              String             @id @default(cuid())
  reportId        String
  oldStatus       MasterReportStatus?
  newStatus       MasterReportStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime           @default(now())
  report          MasterReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  changedByUser   User?              @relation("ReportStatusActor", fields: [changedByUserId], references: [id])

  @@index([reportId, createdAt])
  @@map("report_status_history")
}

model TaskStatusHistory {
  id              String         @id @default(cuid())
  taskId          String
  oldStatus       NgoTaskStatus?
  newStatus       NgoTaskStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime       @default(now())
  task            NgoTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedByUser   User?          @relation("TaskStatusActor", fields: [changedByUserId], references: [id])

  @@index([taskId, createdAt])
  @@map("task_status_history")
}

model TaskEvidence {
  id                 String                     @id @default(cuid())
  taskId             String
  volunteerId        String
  mediaUrl           String
  mediaType          String
  note               String?
  verificationStatus EvidenceVerificationStatus @default(PENDING)
  uploadedAt         DateTime                   @default(now())
  reviewedAt         DateTime?
  reviewedByUserId   String?
  task               NgoTask                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  volunteer          VolunteerProfile           @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  reviewedByUser     User?                      @relation("EvidenceReviewer", fields: [reviewedByUserId], references: [id])

  @@index([taskId, uploadedAt])
  @@map("task_evidence")
}

model VolunteerAssignment {
  id               String           @id @default(cuid())
  taskId           String
  volunteerId      String
  assignmentStatus AssignmentStatus @default(PENDING)
  aiMatchScore     Float?
  assignedByUserId String?
  assignedAt       DateTime         @default(now())
  respondedAt      DateTime?
  note             String?
  task             NgoTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  volunteer        VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  assignedByUser   User?            @relation("AssignmentActor", fields: [assignedByUserId], references: [id])

  @@unique([taskId, volunteerId])
  @@index([volunteerId, assignmentStatus])
  @@map("volunteer_assignments")
}

model Notification {
  id              String           @id @default(cuid())
  recipientUserId String
  role            Role
  title           String
  body            String
  type            NotificationType
  meta            Json?
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  recipientUser   User             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, isRead, createdAt])
  @@map("notifications")
}

model AiDecision {
  id                String         @id @default(cuid())
  reportId          String?
  taskId            String?
  decisionType      AiDecisionType
  inputPayloadJson  Json
  outputPayloadJson Json
  confidenceScore   Float?
  createdAt         DateTime       @default(now())
  report            MasterReport?  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  task              NgoTask?       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([decisionType, createdAt])
  @@map("ai_decisions")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actorRole    Role?
  action       String
  entityType   String
  entityId     String
  metadataJson Json?
  createdAt    DateTime @default(now())
  actorUser    User?    @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model Escalation {
  id               String           @id @default(cuid())
  reportId         String?
  taskId           String?
  raisedByUserId   String
  reason           String
  status           EscalationStatus @default(OPEN)
  resolvedByUserId String?
  createdAt        DateTime         @default(now())
  resolvedAt       DateTime?
  report           MasterReport?    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  task             NgoTask?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  raisedByUser     User             @relation("EscalationRaiser", fields: [raisedByUserId], references: [id])
  resolvedByUser   User?            @relation("EscalationResolver", fields: [resolvedByUserId], references: [id])

  @@index([status, createdAt])
  @@map("escalations")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model RoutingConfig {
  id                              String   @id @default(cuid())
  directSameDomainSameRegion      Boolean  @default(true)
  allowOutsideRegionException     Boolean  @default(true)
  uncertainClassificationBelow    Int      @default(65)
  emergencyPriorityThreshold      Int      @default(85)
  autoRouteConfidenceThreshold    Int      @default(72)
  duplicateGeoRadiusKm            Float    @default(1.5)
  duplicateLookbackHours          Int      @default(72)
  updatedAt                       DateTime @updatedAt

  @@map("routing_config")
}
